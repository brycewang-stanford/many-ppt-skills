{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012jSV54uecBxn6Ez6r1hxp2","type":"tool_result","content":"1\t/* ===========================================\n2\t   FIXED 16:9 STAGE: MANDATORY BASE STYLES\n3\t   Include this ENTIRE file in every presentation.\n4\t   Slides are authored at 1920×1080 and scaled as a whole.\n5\t   =========================================== */\n6\t\n7\t/* 1. Lock the browser viewport */\n8\thtml,\n9\tbody {\n10\t    width: 100%;\n11\t    height: 100%;\n12\t    margin: 0;\n13\t    overflow: hidden;\n14\t    background: var(--stage-bg, #000);\n15\t}\n16\t\n17\t/* 2. Full-window deck viewport */\n18\t.deck-viewport {\n19\t    position: fixed;\n20\t    inset: 0;\n21\t    overflow: hidden;\n22\t    background: var(--stage-bg, #000);\n23\t}\n24\t\n25\t/* 3. Fixed 16:9 design canvas.\n26\t   JavaScript sets transform: translate(...) scale(...). */\n27\t.deck-stage {\n28\t    position: absolute;\n29\t    left: 0;\n30\t    top: 0;\n31\t    width: 1920px;\n32\t    height: 1080px;\n33\t    overflow: hidden;\n34\t    transform-origin: 0 0;\n35\t    background: var(--slide-bg, #fff);\n36\t}\n37\t\n38\t/* 4. Slides stack inside the fixed stage.\n39\t   Content must be laid out at 1920×1080, not reflowed per device. */\n40\t.slide {\n41\t    position: absolute;\n42\t    inset: 0;\n43\t    width: 1920px;\n44\t    height: 1080px;\n45\t    overflow: hidden;\n46\t    display: block;\n47\t    visibility: hidden;\n48\t    opacity: 0;\n49\t    pointer-events: none;\n50\t    background: var(--slide-bg, #fff);\n51\t}\n52\t\n53\t.slide.active,\n54\t.slide.visible {\n55\t    visibility: visible;\n56\t    opacity: 1;\n57\t    pointer-events: auto;\n58\t    z-index: 1;\n59\t}\n60\t\n61\t/* 5. Keep media inside authored slide bounds */\n62\timg,\n63\tvideo,\n64\tcanvas,\n65\tsvg {\n66\t    max-width: 100%;\n67\t    max-height: 100%;\n68\t}\n69\t\n70\t/* 6. Presentation chrome stays outside the slide design system */\n71\t.deck-controls {\n72\t    position: fixed;\n73\t    left: 50%;\n74\t    bottom: 22px;\n75\t    transform: translateX(-50%);\n76\t    z-index: 1000;\n77\t}\n78\t\n79\t/* 7. Print one fixed-size slide per page */\n80\t@media print {\n81\t    html,\n82\t    body {\n83\t        width: 1920px;\n84\t        height: auto;\n85\t        overflow: visible;\n86\t        background: #fff;\n87\t    }\n88\t\n89\t    .deck-viewport {\n90\t        position: static;\n91\t        overflow: visible;\n92\t        background: #fff;\n93\t    }\n94\t\n95\t    .deck-stage {\n96\t        position: static;\n97\t        width: auto;\n98\t        height: auto;\n99\t        transform: none !important;\n100\t        background: none;\n101\t    }\n102\t\n103\t    .slide {\n104\t        position: relative;\n105\t        display: block !important;\n106\t        visibility: visible !important;\n107\t        opacity: 1 !important;\n108\t        pointer-events: auto !important;\n109\t        width: 1920px;\n110\t        height: 1080px;\n111\t        break-after: page;\n112\t        page-break-after: always;\n113\t    }\n114\t\n115\t    .slide:last-child {\n116\t        break-after: auto;\n117\t        page-break-after: auto;\n118\t    }\n119\t\n120\t    .deck-controls {\n121\t        display: none !important;\n122\t    }\n123\t}\n124\t\n125\t/* 8. Reduced motion */\n126\t@media (prefers-reduced-motion: reduce) {\n127\t    *,\n128\t    *::before,\n129\t    *::after {\n130\t        animation-duration: 0.01ms !important;\n131\t        transition-duration: 0.2s !important;\n132\t    }\n133\t}\n134\t"}]},"parent_tool_use_id":null,"session_id":"170e2903-4018-4657-846f-4d4287473de7","uuid":"4126442b-5883-4263-8208-b068c28d93ea","timestamp":"2026-07-28T10:29:43.477Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/brycewang/Documents/GitHub/many-ppt-skills/benchmark/results/run-01/frontend-slides/01-product-launch/rep-01/workspace/.claude/skills/frontend-slides/viewport-base.css","content":"/* ===========================================\n   FIXED 16:9 STAGE: MANDATORY BASE STYLES\n   Include this ENTIRE file in every presentation.\n   Slides are authored at 1920×1080 and scaled as a whole.\n   =========================================== */\n\n/* 1. Lock the browser viewport */\nhtml,\nbody {\n    width: 100%;\n    height: 100%;\n    margin: 0;\n    overflow: hidden;\n    background: var(--stage-bg, #000);\n}\n\n/* 2. Full-window deck viewport */\n.deck-viewport {\n    position: fixed;\n    inset: 0;\n    overflow: hidden;\n    background: var(--stage-bg, #000);\n}\n\n/* 3. Fixed 16:9 design canvas.\n   JavaScript sets transform: translate(...) scale(...). */\n.deck-stage {\n    position: absolute;\n    left: 0;\n    top: 0;\n    width: 1920px;\n    height: 1080px;\n    overflow: hidden;\n    transform-origin: 0 0;\n    background: var(--slide-bg, #fff);\n}\n\n/* 4. Slides stack inside the fixed stage.\n   Content must be laid out at 1920×1080, not reflowed per device. */\n.slide {\n    position: absolute;\n    inset: 0;\n    width: 1920px;\n    height: 1080px;\n    overflow: hidden;\n    display: block;\n    visibility: hidden;\n    opacity: 0;\n    pointer-events: none;\n    background: var(--slide-bg, #fff);\n}\n\n.slide.active,\n.slide.visible {\n    visibility: visible;\n    opacity: 1;\n    pointer-events: auto;\n    z-index: 1;\n}\n\n/* 5. Keep media inside authored slide bounds */\nimg,\nvideo,\ncanvas,\nsvg {\n    max-width: 100%;\n    max-height: 100%;\n}\n\n/* 6. Presentation chrome stays outside the slide design system */\n.deck-controls {\n    position: fixed;\n    left: 50%;\n    bottom: 22px;\n    transform: translateX(-50%);\n    z-index: 1000;\n}\n\n/* 7. Print one fixed-size slide per page */\n@media print {\n    html,\n    body {\n        width: 1920px;\n        height: auto;\n        overflow: visible;\n        background: #fff;\n    }\n\n    .deck-viewport {\n        position: static;\n        overflow: visible;\n        background: #fff;\n    }\n\n    .deck-stage {\n        position: static;\n        width: auto;\n        height: auto;\n        transform: none !important;\n        background: none;\n    }\n\n    .slide {\n        position: relative;\n        display: block !important;\n        visibility: visible !important;\n        opacity: 1 !important;\n        pointer-events: auto !important;\n        width: 1920px;\n        height: 1080px;\n        break-after: page;\n        page-break-after: always;\n    }\n\n    .slide:last-child {\n        break-after: auto;\n        page-break-after: auto;\n    }\n\n    .deck-controls {\n        display: none !important;\n    }\n}\n\n/* 8. Reduced motion */\n@media (prefers-reduced-motion: reduce) {\n    *,\n    *::before,\n    *::after {\n        animation-duration: 0.01ms !important;\n        transition-duration: 0.2s !important;\n    }\n}\n","numLines":134,"startLine":1,"totalLines":134}}}
